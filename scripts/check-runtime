#!/usr/bin/env bash
# Optional integration test: requires a running Omarchy Wayland session.
# Uses temporary config/state and fixture weather responses, never personal data.
set -euo pipefail
scenario=${1:-shell.qml}
[[ $scenario == category-lifecycle.qml || $scenario == placement-layout.qml || $scenario == shell.qml || $scenario == controls.qml || $scenario == weather-startup.qml || $scenario == audio-theme.qml || $scenario == rain.qml || $scenario == lifecycle.qml ]] || { echo "Unknown scenario" >&2; exit 2; }
repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
[[ -n ${WAYLAND_DISPLAY:-} ]] || { echo 'A running Wayland session is required' >&2; exit 1; }
test_dir=$(mktemp -d)
trap 'rm -rf -- "$test_dir"' EXIT
mkdir -p "$test_dir/config/drunkleen.desktop-aio" "$test_dir/state" "$test_dir/bin"
cp "$repo/tests/runtime/$scenario" "$test_dir/shell.qml"
cp "$repo/tests/runtime/close-window" "$test_dir/close-window"
cp "$repo/tests/runtime/curl" "$test_dir/bin/curl"
ln -s "$repo" "$test_dir/plugin"
for module in Ui Commons services; do ln -s "${OMARCHY_PATH:-/usr/share/omarchy}/shell/$module" "$test_dir/$module"; done
printf '%s\n' 'monitor="__test__"' 'show_weather=false' 'show_spectrum=false' > "$test_dir/config/drunkleen.desktop-aio/config.toml"
weather_failure=""
if [[ $scenario == weather-startup.qml ]]; then
  printf '%s\n' 'show_weather=true' 'show_spectrum=false' '[weather]' 'city="Dresden"' 'label="Dresden, Saxony, Germany"' 'location_city="Dresden"' 'latitude=51.05089' 'longitude=13.73832' 'refresh_seconds=900' > "$test_dir/config/drunkleen.desktop-aio/config.toml"
  weather_failure="$test_dir/first-request"
fi
AIO_WEATHER_FAIL_ONCE="$weather_failure" PATH="$test_dir/bin:$PATH" XDG_CONFIG_HOME="$test_dir/config" XDG_STATE_HOME="$test_dir/state" timeout 35 qs -p "$test_dir" --no-color > "$test_dir/log" 2>&1 || { cat "$test_dir/log"; exit 1; }
cat "$test_dir/log"
grep -q 'AIO_RUNTIME_PASS' "$test_dir/log"
error_status=0
grep -Eq 'AIO_RUNTIME_FAIL|(^|[^[:alnum:]_])ERROR([[:space:]:]|$)|ReferenceError|TypeError|Binding loop|Unable to assign' "$test_dir/log" || error_status=$?
[[ $error_status == 1 ]]
