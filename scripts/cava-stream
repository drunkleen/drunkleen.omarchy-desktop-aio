#!/usr/bin/env bash
set -euo pipefail
command -v cava >/dev/null 2>&1 || exit 0
# Only numeric arguments are allowed, even when invoked outside QML.
[[ ${1:-} =~ ^[0-9]+$ && ${2:-} =~ ^[0-9]+$ && ${3:-} =~ ^[0-9]+$ ]] || exit 2
cfg=$(mktemp)
trap 'rm -f -- "$cfg"' EXIT
cat > "$cfg" <<EOF
[general]
framerate = $1
bars = $2
[input]
method = pipewire
source = auto
[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 100
channels = mono
mono_option = average
[smoothing]
noise_reduction = $3
EOF
cava -p "$cfg"
