#!/usr/bin/env bash
set -euo pipefail
command -v cava >/dev/null 2>&1 || exit 0
# Only numeric arguments are allowed, even when invoked outside QML.
[[ ${1:-} =~ ^[0-9]+$ && ${2:-} =~ ^[0-9]+$ && ${3:-} =~ ^[0-9]+$ ]] || exit 2
source=${4:-auto}
[[ $source == auto || ( $source =~ ^[A-Za-z0-9_.:@/-]+$ && $source == *.monitor ) ]] || exit 2
cfg=$(mktemp)
child=""
cleanup() { if [[ -n $child ]]; then kill "$child" 2>/dev/null || true; wait "$child" 2>/dev/null || true; fi; rm -f -- "$cfg"; }
trap cleanup EXIT
trap 'exit 0' TERM INT
cat > "$cfg" <<EOF
[general]
framerate = $1
bars = $2
[input]
method = pulse
source = $source
[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 100
channels = mono
mono_option = average
[smoothing]
noise_reduction = $3
EOF
cava -p "$cfg" &
child=$!
wait "$child"
child=""
