#!/usr/bin/env bash
set -euo pipefail
url=${!#}
case "$url" in
  *name=invalid*) echo '{"results":[]}' ;;
  *geocoding*) echo '{"results":[{"name":"Paris","admin1":"Texas","country":"USA","latitude":33,"longitude":-95},{"name":"Paris","admin1":"Île-de-France","country":"France","latitude":48,"longitude":2}]}' ;;
  *temperature_unit=fahrenheit*) echo '{"current":{"temperature_2m":68,"is_day":1,"weather_code":0}}' ;;
  *) echo '{"current":{"temperature_2m":20,"is_day":1,"weather_code":0}}' ;;
esac
